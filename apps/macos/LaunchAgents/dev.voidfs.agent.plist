<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The extension's bridge to the daemon: the app itself, run as a launchd agent that answers
     the extension's XPC on the App-Group-prefixed name. Registered with SMAppService. Adaptive:
     launchd treats it as interactive while it serves the extension's calls. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.voidfs.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/voidfs</string>
	<key>ProgramArguments</key>
	<array>
		<string>voidfs</string>
		<string>agent</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>HAUTK68F56.dev.voidfs.agent</key>
		<true/>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.voidfs.app</string>
	</array>
</dict>
</plist>
