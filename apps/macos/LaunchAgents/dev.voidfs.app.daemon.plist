<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The daemon at login (step 5, item 7): the app's own binary, run as `voidfs daemon-launch`,
     which finds the app's state directory (its VoidfsStateDirectory default, or the CLI's
     default), opens the daemon.log there, reads the server's key from the app's Keychain and
     runs the app's copy of `void` as `void daemon run --app --logged`, with the key on its stdin.
     That daemon takes over from one started otherwise, the agent `void daemon install` wrote
     included. Start at login in the menu registers it with SMAppService. launchd runs it again if
     it dies, but not after it stopped as asked, as the terminal's agent does. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.voidfs.app.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/voidfs</string>
	<key>ProgramArguments</key>
	<array>
		<string>voidfs</string>
		<string>daemon-launch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.voidfs.app</string>
	</array>
</dict>
</plist>
